{
  "pipeline": "translate",
  "translateProvider": "bailian",
  "bailianRegion": "singapore",
  "bailianWorkspaceID": "YOUR_WORKSPACE_ID",
  "bailianAPIKey": "YOUR_BAILIAN_KEY",
  "bailianTranslateModel": "qwen3.8-livetranslate-flash-realtime",
  "bailianTurnDetection": "server_vad",
  "bailianTransport": "websocket",
  "playbackCatchUp": {
    "enabled": true,
    "enterSeconds": 1.5,
    "exitSeconds": 0.75,
    "maximumRate": 1.5,
    "recoveryWindowSeconds": 20,
    "maximumBufferedSeconds": 120
  },
  "apiKey": "YOUR_GOOGLE_KEY_FOR_TRANSCRIBE",
  "transcribeProvider": "google",
  "localWhisper": {
    "model": "openai_whisper-large-v3-v20240930_turbo",
    "language": "en",
    "modelDirectory": "",
    "updateIntervalSeconds": 0.8
  },
  "transcribeModel": "gemini-3.5-transcribe-live",
  "translationMode": "subtitles",
  "subtitleLayout": "bilingual",
  "targetLanguage": "zh-Hans",
  "logDirectory": "~/Documents/LiveCaption Logs",
  "systemAudioEnabled": true,
  "microphoneEnabled": false,
  "systemNoiseSuppression": true,
  "microphoneVoiceProcessing": true,
  "captionReflow": {
    "enabled": false,
    "engine": "sat",
    "sat": {
      "model": "sat-3l",
      "pythonExecutable": "~/Library/Application Support/LiveCaption/SaT/runtime/bin/python3",
      "paragraphThreshold": 0.2,
      "minimumCharacters": 120,
      "timeoutSeconds": 120
    }
  }
}
